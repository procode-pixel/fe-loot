# FeLoot production environment
# Copy to .env.local for local dev, or set these in the Vercel project settings.

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI)
# Use the pooler URI (port 6543) for Vercel serverless.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Random 24+ char secret that signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=

# Separate random 32+ char secret for AES-256-GCM encryption of delivery credentials.
ENCRYPTION_KEY=

# Admin account (admin@feloot.app) password, 10+ chars. Set before first production boot.
ADMIN_PASSWORD=

# Optional: protects cron/ops endpoints, 16+ chars.
CRON_SECRET=
